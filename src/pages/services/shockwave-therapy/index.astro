---
import home from '../../../data/home.json';
import page from '../../../data/shockwave-therapy.json';
import FeaturedPractitioner from '../../../components/FeaturedPractitioner.astro';
import SiteNavigation from '../../../components/SiteNavigation.astro';

const bookingUrl = home.site.bookingUrl.startsWith('#') ? `/${home.site.bookingUrl}` : home.site.bookingUrl;
const faqs = page.faqs.map(({question,answer}) => [question,answer]);
const pageUrl = 'https://alpha-sports-med-prototype.pages.dev/services/shockwave-therapy/';
const schema = {'@context':'https://schema.org','@graph':[{'@type':'MedicalWebPage',name:'Shockwave Therapy in Melbourne',url:pageUrl,about:{'@type':'MedicalTherapy',name:'Extracorporeal shockwave therapy (ESWT)'}},{'@type':'FAQPage',mainEntity:faqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))}]};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{page.seo.title}</title>
  <meta name="description" content={page.seo.description} />
  <link rel="canonical" href={pageUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@500;700&family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" /><link rel="stylesheet" href="/assets/css/style.css?v=20260827-3" /><link rel="stylesheet" href="/assets/css/service.css?v=20260928-1" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <header class="site-header">
    <div class="site-header__inner"><a href="/" class="site-header__logo" aria-label="Alpha Sports Medicine home"><img src="/assets/images/alpha-icon.png" alt="" class="site-header__logo-icon" /><img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" class="site-header__logo-full" /></a><div class="site-header__actions"><a class="site-header__phone" href={home.site.phoneHref}><span class="site-header__phone-icon"><i class="fas fa-phone-alt" aria-hidden="true"></i></span><span class="site-header__phone-text"> {home.site.phoneDisplay}</span></a><a href={bookingUrl} class="btn btn--primary">Book online</a><button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false"><i class="fas fa-bars" aria-hidden="true"></i></button></div></div>
    <div class="site-header__nav-row"><SiteNavigation /></div>
    <SiteNavigation variant="mobile" />
  </header>
  <main>
    <section class="service-hero"><div class="service-hero__inner"><div><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/#services">Services</a><span>/</span><span>Shockwave Therapy</span></nav><p class="eyebrow eyebrow--left">{page.hero.eyebrow}</p><h1>{page.hero.heading}</h1><p class="service-hero__subhead">{page.hero.subheading}</p><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book an assessment <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a href={home.site.phoneHref} class="btn btn--outline"><i class="fas fa-phone-alt" aria-hidden="true"></i> Call {home.site.phoneDisplay}</a></div></div><FeaturedPractitioner context="service" slug="shockwave-therapy" variant="hero" /></div></section>

    <section class="section service-intro"><div><div class="section-head section-head--left"><span class="section-head__ghost">ESWT</span><p class="eyebrow eyebrow--left">{page.intro.eyebrow}</p><h2>{page.intro.heading}</h2></div>{page.intro.paragraphs.map((paragraph) => <p set:html={paragraph} />)}</div><figure><img src={page.intro.image} alt={page.intro.imageAlt} loading="lazy" /><figcaption><i class="fas fa-check-circle"></i> {page.intro.caption}</figcaption></figure></section>

    <section class="section section--alt service-explainer"><div class="section-head section-head--left service-explainer__heading"><span class="section-head__ghost" aria-hidden="true">WHY</span><p class="eyebrow eyebrow--left">{page.explainer.eyebrow}</p><h2>{page.explainer.heading}</h2><div class="service-explainer__concept"><i class="fas fa-search" aria-hidden="true"></i><span><strong>Diagnosis comes first</strong><small>Shockwave is most effective when it's targeted at the correct structure.</small></span></div></div><div>{page.explainer.paragraphs.map((paragraph) => <p set:html={paragraph} />)}</div></section>

    <section class="section section--navy"><div class="section-head"><span class="section-head__ghost">HOW</span><p class="eyebrow">{page.howItWorks.eyebrow}</p><h2>{page.howItWorks.heading}</h2></div><div class="service-prose">{page.howItWorks.paragraphs.map((paragraph) => <p set:html={paragraph} />)}<p><strong>{page.howItWorks.highlight}</strong></p></div></section>

    <section class="section"><div class="section-head"><span class="section-head__ghost">SUPPORT</span><p class="eyebrow">Common reasons to visit</p><h2>{page.conditions.heading}</h2><p>{page.conditions.intro}</p></div><div class="card-grid service-condition-grid">{page.conditions.items.map((item) => <div class="condition-card"><span class="condition-card__icon"><i class={`fas ${item.icon}`} aria-hidden="true"></i></span><span class="condition-card__content"><span class="condition-card__label">{item.title}</span>{item.copy && <small set:html={item.copy} />}</span></div>)}</div><p class="service-note"><i class="fas fa-info-circle" aria-hidden="true"></i> {page.conditions.note}</p></section>

    <section class="section section--alt"><div class="section-head"><span class="section-head__ghost">VISIT</span><p class="eyebrow">{page.visit.eyebrow}</p><h2>{page.visit.heading}</h2></div><ol class="visit-steps">{page.visit.steps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.copy}</p></li>)}</ol></section>

    <section class="section service-team"><img src={page.team.image} alt={page.team.imageAlt} loading="lazy" /><div class="service-team__copy"><p class="eyebrow eyebrow--left">{page.team.eyebrow}</p><h2>{page.team.heading}</h2>{page.team.paragraphs.map((paragraph) => <p class="service-team__description" set:html={paragraph} />)}<div class="btn-group"><a href="/about/team/" class="btn btn--primary">Meet the team <i class="fas fa-arrow-right"></i></a><a href="/services/osteopathy/" class="btn btn--outline-navy">Osteopathy <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div></div></section>

    <section id="locations" class="section section--alt">
      <div class="section-head"><span class="section-head__ghost" aria-hidden="true">LOCATIONS</span><p class="eyebrow">Where to see us</p><h2>Shockwave therapy across Melbourne</h2></div>
      <div class="location-grid">
        <div class="location-card" style="background-image: url('/assets/images/locations/ascot-vale-storefront.jpg');"><span class="location-card__pin"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span><a href="/locations/ascot-vale/" class="location-card__link" aria-label="View Ascot Vale clinic"><i class="fas fa-external-link-alt" aria-hidden="true"></i></a><h3>Ascot Vale</h3><p class="location-card__address"><i class="fas fa-map-marker-alt" aria-hidden="true"></i>246A Union Rd, Ascot Vale</p><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book</a></div></div>
        <div class="location-card" style="background-image: url('/assets/images/locations/newport-storefront.jpg');"><span class="location-card__pin"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span><a href="/locations/newport/" class="location-card__link" aria-label="View Newport clinic"><i class="fas fa-external-link-alt" aria-hidden="true"></i></a><h3>Newport</h3><p class="location-card__address"><i class="fas fa-map-marker-alt" aria-hidden="true"></i>109 Blackshaws Rd, Newport</p><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book</a></div></div>
        <div class="location-card" style="background-image: url('/assets/images/locations/bacchus-marsh-storefront.jpg');"><span class="location-card__pin"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span><a href="/locations/bacchus-marsh/" class="location-card__link" aria-label="View Bacchus Marsh clinic"><i class="fas fa-external-link-alt" aria-hidden="true"></i></a><h3>Bacchus Marsh</h3><p class="location-card__address"><i class="fas fa-map-marker-alt" aria-hidden="true"></i>3 Graham St, Bacchus Marsh</p><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book</a></div></div>
      </div>
      <div class="locations__footer"><p class="locations__phone"><i class="fas fa-phone-alt" aria-hidden="true"></i>One number for all clinics: {home.site.phoneDisplay}</p><a href="/locations/" class="locations__link">See all the suburbs we serve <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div>
    </section>

    <section class="section"><div class="section-head"><span class="section-head__ghost">FAQ</span><p class="eyebrow">Good to know</p><h2>FAQs about Shockwave Therapy</h2></div><div class="faq__list">{faqs.map(([q,a])=><details class="faq__item"><summary><span>{q}</span></summary><div class="faq__answer"><p>{a}</p></div></details>)}</div></section>

    <section class="section section--alt service-references"><div class="section-head section-head--left"><p class="eyebrow eyebrow--left">Sources</p><h2>References</h2></div><ol>{page.references.map((ref) => <li><a href={ref.url} target="_blank" rel="noopener">{ref.label}</a></li>)}</ol></section>

    <section class="section section--navy closing-cta closing-cta--osteopathy"><div class="section-head"><span class="section-head__ghost">MOVE</span><p class="eyebrow">{page.closing.eyebrow}</p><h2>{page.closing.heading}</h2><p>{page.closing.copy}</p></div><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book an assessment <i class="fas fa-arrow-right"></i></a><a href={home.site.phoneHref} class="btn btn--outline">Call {home.site.phoneDisplay}</a></div></section>
  </main>
  <footer class="site-footer"><div class="site-footer__inner"><div class="site-footer__grid"><div><a href="/" class="site-footer__logo"><img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" /></a><p>Multidisciplinary sports medicine clinics across Melbourne. Care built around your goals.</p></div><div><h5>Clinics</h5><ul><li><a href="/locations/ascot-vale/">Ascot Vale</a></li><li><a href="/locations/newport/">Newport</a></li><li><a href="/locations/bacchus-marsh/">Bacchus Marsh</a></li><li><a href="/locations/hawthorn/">Hawthorn</a></li></ul></div><div><h5>About</h5><ul><li><a href="/about/">Our clinic</a></li><li><a href="/about/team/">Meet the team</a></li><li><a href="/about/qualifications/">Qualifications</a></li></ul></div><div><h5>Contact</h5><ul><li><a href={home.site.phoneHref}>{home.site.phoneDisplay}</a></li><li><a href="/contact/">Contact us</a></li><li><a href={bookingUrl}>Book online</a></li></ul></div></div><div class="site-footer__bottom"><p>&copy; 2026 Alpha Sports Medicine.</p></div></div></footer>
  <script is:inline src="/assets/js/main.js"></script>
</body></html>
