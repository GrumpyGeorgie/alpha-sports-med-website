---
import home from '../../../data/home.json';
import FeaturedPractitioner from '../../../components/FeaturedPractitioner.astro';

const bookingUrl = home.site.bookingUrl.startsWith('#') ? `/${home.site.bookingUrl}` : home.site.bookingUrl;
const benefits = [
  ['fa-comments', 'We take the time', 'We start with your history, what you have tried and what you want to get back to.'],
  ['fa-search', 'We look wider', 'Your assessment considers the painful area and how the regions around it may contribute.'],
  ['fa-clipboard-list', 'You leave with a plan', 'Hands-on care is paired with practical exercises shaped around your life.'],
  ['fa-dumbbell', 'We build you back up', 'Rehabilitation and strength support are available within the wider Alpha team.'],
  ['fa-sync-alt', 'We re-test', 'We review how you move and respond, then adapt the plan with you.'],
  ['fa-user-check', 'You stay in control', 'Every option is explained first; firmer techniques are consent-led and optional.']
];
const conditions = [
  ['Back pain', '/conditions/back-pain/', 'fa-user-injured', 'Pain that keeps interrupting work, training or sleep.'],
  ['Neck pain', '/conditions/neck-pain/', 'fa-head-side-virus', 'A neck that feels restricted, overloaded or persistently sore.'],
  ['Headaches', '/conditions/headaches/', 'fa-brain', 'Headaches linked with neck or upper-back tension.'],
  ['Shoulder pain', '/conditions/shoulder-pain/', 'fa-dumbbell', 'Support for reaching, lifting and returning to exercise.'],
  ['Hip pain', '/conditions/hip-pain/', 'fa-walking', 'When walking, running, sitting or training is uncomfortable.'],
  ['TMJ and jaw pain', '/conditions/tmj-jaw-pain/', 'fa-teeth-open', 'Jaw tension, clicking and related neck discomfort.'],
  ['Sports injuries', '/conditions/sports-injuries/', 'fa-futbol', 'A hands-on and rehab-led route back to sport.'],
  ['Running injuries', '/conditions/running-injuries/', 'fa-running', 'Care that considers movement, load and your training.'],
  ['Pregnancy-related pain', '/conditions/pregnancy-pain/', 'fa-baby', 'Adapted care through pregnancy and physical change.'],
  ['Hypermobility', '/conditions/hypermobility/', 'fa-notes-medical', 'Care shaped around control, capacity and your presentation.']
];
const faqs = [
  ['Do I need a referral?', 'No. You can book an osteopath directly without a GP referral.'],
  ['Can I claim on private health?', 'Osteopathy may be covered when your extras policy includes it. On-site claiming is available; check your cover with your fund.'],
  ['Is osteopathy safe, and does it hurt?', 'Osteopathy is generally low-risk when provided by a registered practitioner. Some techniques feel firm, so your osteopath will explain options and check in throughout.'],
  ['Do osteopaths “crack” backs?', 'Joint manipulation is one option among many. It is only used when appropriate, discussed with you and consented to. You can always choose not to have it.'],
  ['How many appointments will I need?', 'That depends on your presentation and response. Your osteopath will review progress with you rather than prescribe a fixed number upfront.'],
  ['Can I see an osteopath while pregnant?', 'Care can be adapted during pregnancy, taking your stage, history and comfort into account and coordinating with your maternity team when needed.']
];
const schema = {'@context':'https://schema.org','@graph':[{'@type':'MedicalWebPage',name:'Osteopathy in Melbourne',url:'https://alpha-sports-med-prototype.pages.dev/services/osteopathy/'},{'@type':'FAQPage',mainEntity:faqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))}]};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Osteopath Melbourne | Alpha Sports Medicine</title>
  <meta name="description" content="Hands-on osteopathy plus a practical rehab plan. AHPRA-registered osteopaths across Melbourne's west. No referral needed—book online." />
  <link rel="canonical" href="https://alpha-sports-med-prototype.pages.dev/services/osteopathy/" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@500;700&family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" /><link rel="stylesheet" href="/assets/css/style.css?v=20260827-3" /><link rel="stylesheet" href="/assets/css/service.css?v=20260827-3" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <header class="site-header">
    <div class="site-header__inner"><a href="/" class="site-header__logo" aria-label="Alpha Sports Medicine home"><img src="/assets/images/alpha-icon.png" alt="" class="site-header__logo-icon" /><img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" class="site-header__logo-full" /></a><div class="site-header__actions"><a class="site-header__phone" href={home.site.phoneHref}><span class="site-header__phone-icon"><i class="fas fa-phone-alt" aria-hidden="true"></i></span><span class="site-header__phone-text"> {home.site.phoneDisplay}</span></a><a href={bookingUrl} class="btn btn--primary">Book online</a><button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false"><i class="fas fa-bars" aria-hidden="true"></i></button></div></div>
    <div class="site-header__nav-row"><nav class="site-header__nav" aria-label="Primary"><a href="/">Home</a><a href="/about/">Meet Us</a><a href="/#services" aria-current="page">What We Do</a><a href="/#who-we-support">Who We Support</a><a href="/#conditions">Conditions</a><a href="/#getting-started">Getting Started</a><a href="/#locations">Locations</a><a href="/contact/">Contact Us</a></nav></div>
    <nav class="mobile-nav" aria-label="Mobile"><a href="/">Home</a><a href="/about/">Meet Us</a><a href="/#services">What We Do</a><a href="/#conditions">Conditions</a><a href="/#locations">Locations</a><a href="/contact/">Contact Us</a></nav>
  </header>
  <main>
    <section class="service-hero"><div class="service-hero__inner"><div><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/#services">Services</a><span>/</span><span>Osteopathy</span></nav><p class="eyebrow eyebrow--left">Alpha Sports Medicine · Osteopathy</p><h1>Osteopathy in Melbourne to keep you moving</h1><p class="service-hero__subhead">Hands-on osteopathic treatment, plus a rehabilitation plan to back it up—so you can get on with your training, your sport and your life.</p><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book an appointment <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a href={home.site.phoneHref} class="btn btn--outline"><i class="fas fa-phone-alt" aria-hidden="true"></i> Call {home.site.phoneDisplay}</a></div></div><FeaturedPractitioner context="service" slug="osteopathy" variant="hero" /></div></section>

    <section class="section service-intro"><div><div class="section-head section-head--left"><span class="section-head__ghost">MOVE</span><p class="eyebrow eyebrow--left">Your recovery team</p><h2>Is an osteo on your recovery team?</h2></div><p>Whether you are chasing a personal best, getting back into the gym or simply want to move through your day without something nagging at you, an osteopath can help you work towards that goal.</p><p>If an issue keeps returning after you thought it was sorted, it is worth looking at properly. We start by understanding the whole picture, not just the sore spot.</p></div><figure><img src="/assets/images/locations/hawthorn-clinic.jpg" alt="Alpha Sports Medicine practitioner providing hands-on treatment" loading="lazy" /><figcaption><i class="fas fa-check-circle"></i> Hands-on care with a practical next step</figcaption></figure></section>

    <section class="section section--alt service-explainer"><div class="section-head section-head--left service-explainer__heading"><span class="section-head__ghost" aria-hidden="true">WHOLE</span><p class="eyebrow eyebrow--left">Plain-language care</p><h2>What is osteopathy?</h2><div class="service-explainer__concept"><i class="fas fa-link" aria-hidden="true"></i><span><strong>One connected system</strong><small>We look at how movement and load travel through your body—not only where it hurts.</small></span></div></div><div><p>Osteopathy is a hands-on form of healthcare focused on the musculoskeletal system: your joints, muscles, ligaments and the connective tissue around them. In Australia, osteopaths are registered through AHPRA and complete five years of university training.</p><p>Your body does not move as a set of separate parts. Load travels. A restricted hip may change how your lower back works; a stiff upper back may contribute to an overloaded neck. That is why your osteopath assesses more than the area that hurts.</p><p>Treatment may include soft-tissue techniques, joint mobilisation, stretching and—where appropriate and with your consent—dry needling or manipulation. The aim is to pair treatment with a plan that supports the movement and capacity you need outside the clinic.</p></div></section>

    <section class="section section--navy"><div class="section-head"><span class="section-head__ghost">ALPHA</span><p class="eyebrow">How we work</p><h2>The Alpha osteo difference</h2><p>What happens on either side of the treatment table matters just as much as the hands-on care.</p></div><div class="service-feature-grid">{benefits.map(([icon,title,copy])=><article><i class={`fas ${icon}`}></i><h3>{title}</h3><p>{copy}</p></article>)}</div></section>

    <section class="section"><div class="section-head"><span class="section-head__ghost">SUPPORT</span><p class="eyebrow">Common reasons to visit</p><h2>What osteopathy may help with</h2><p>Choose what sounds closest to what you are dealing with.</p></div><div class="card-grid service-condition-grid">{conditions.map(([title, href, icon, copy]) => <a href={href} class="condition-card"><span class="condition-card__icon"><i class={`fas ${icon}`} aria-hidden="true"></i></span><span class="condition-card__content"><span class="condition-card__label">{title}</span><small>{copy}</small></span></a>)}</div></section>

    <section class="section section--alt"><div class="section-head"><span class="section-head__ghost">VISIT</span><p class="eyebrow">What to expect</p><h2>Your first osteopathy appointment</h2><p>A clear, conversational process with no surprises.</p></div><ol class="visit-steps"><li><span>01</span><h3>Tell us what is going on</h3><p>We discuss your history, what you have tried and what you want to return to.</p></li><li><span>02</span><h3>Move through an assessment</h3><p>Your osteopath looks at how you move and explains what they notice.</p></li><li><span>03</span><h3>Agree on treatment</h3><p>Options are explained before any hands-on care begins.</p></li><li><span>04</span><h3>Leave with a plan</h3><p>You will usually have practical exercises or advice for between visits.</p></li></ol><div class="visit-notes"><article><i class="fas fa-tshirt" aria-hidden="true"></i><div><h3>Come in comfortable clothes</h3><p>Wear something you can move in—activewear works well.</p></div></article><article><i class="fas fa-hand-paper" aria-hidden="true"></i><div><h3>You set the pace</h3><p>Treatment can feel firm, but it should never feel like something happening to you. Tell us what feels okay.</p></div></article><article><i class="fas fa-route" aria-hidden="true"></i><div><h3>We will plan as we go</h3><p>There is no stock number of visits. After assessing you, we will explain what we think and review it as you progress.</p></div></article></div></section>

    <section class="section service-team"><img src="/assets/images/team/alpha-team-group.jpg" alt="Alpha Sports Medicine clinical team" loading="lazy" /><div class="service-team__copy"><p class="eyebrow eyebrow--left">Our osteopaths</p><h2>Osteopathy is where Alpha started</h2><p class="service-team__description">Alpha was founded by osteopaths Dr Ashton Wilson and Dr Will Krithararis. They have built a multidisciplinary team around a shared approach: listen properly, explain clearly and connect hands-on care with meaningful rehabilitation.</p><div class="btn-group"><a href="/about/team/" class="btn btn--primary">Meet the team <i class="fas fa-arrow-right"></i></a><a href="/about/qualifications/" class="btn btn--outline-navy">Our qualifications <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div></div></section>

    <section id="locations" class="section section--alt">
      <div class="section-head"><span class="section-head__ghost" aria-hidden="true">LOCATIONS</span><p class="eyebrow">Where to see us</p><h2>Osteopathy across four Melbourne clinics</h2></div>
      <div class="location-grid">
        <div class="location-card" style="background-image: url('/assets/images/locations/ascot-vale-storefront.jpg');"><span class="location-card__pin"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span><a href="/locations/ascot-vale/" class="location-card__link" aria-label="View Ascot Vale clinic"><i class="fas fa-external-link-alt" aria-hidden="true"></i></a><h3>Ascot Vale</h3><p class="location-card__address"><i class="fas fa-map-marker-alt" aria-hidden="true"></i>246A Union Rd, Ascot Vale</p><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book</a></div></div>
        <div class="location-card" style="background-image: url('/assets/images/locations/newport-storefront.jpg');"><span class="location-card__pin"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span><a href="/locations/newport/" class="location-card__link" aria-label="View Newport clinic"><i class="fas fa-external-link-alt" aria-hidden="true"></i></a><h3>Newport</h3><p class="location-card__address"><i class="fas fa-map-marker-alt" aria-hidden="true"></i>109 Blackshaws Rd, Newport</p><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book</a></div></div>
        <div class="location-card" style="background-image: url('/assets/images/locations/bacchus-marsh-storefront.jpg');"><span class="location-card__pin"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span><a href="/locations/bacchus-marsh/" class="location-card__link" aria-label="View Bacchus Marsh clinic"><i class="fas fa-external-link-alt" aria-hidden="true"></i></a><h3>Bacchus Marsh</h3><p class="location-card__address"><i class="fas fa-map-marker-alt" aria-hidden="true"></i>3 Graham St, Bacchus Marsh</p><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book</a></div></div>
        <div class="location-card location-card--hawthorn"><span class="location-card__pin"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span><a href="https://maps.app.goo.gl/bBiEZyTG2B6cS8ry8" target="_blank" rel="noopener noreferrer" class="location-card__link" aria-label="View Hawthorn clinic on Google Maps"><i class="fas fa-external-link-alt" aria-hidden="true"></i></a><h3>Hawthorn</h3><p class="location-card__address"><i class="fas fa-map-marker-alt" aria-hidden="true"></i>432 Burwood Rd, Hawthorn VIC 3122</p><div class="btn-group"><a href="https://maps.app.goo.gl/bBiEZyTG2B6cS8ry8" target="_blank" rel="noopener noreferrer" class="btn btn--primary">View on Maps</a></div></div>
      </div>
      <div class="locations__footer"><p class="locations__phone"><i class="fas fa-phone-alt" aria-hidden="true"></i>One number for all four: {home.site.phoneDisplay}</p><a href="/locations/" class="locations__link">See all the suburbs we serve <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div>
    </section>

    <section class="section"><div class="section-head"><span class="section-head__ghost">FAQ</span><p class="eyebrow">Good to know</p><h2>Osteopathy FAQs</h2></div><div class="faq__list">{faqs.map(([q,a])=><details class="faq__item"><summary><span>{q}</span></summary><div class="faq__answer"><p>{a}</p></div></details>)}</div></section>
    <section class="section section--navy closing-cta"><div class="section-head"><span class="section-head__ghost">MOVE</span><p class="eyebrow">Your next step</p><h2>Get support from a team that is on your side</h2><p>Together, we can work out what is going on and build a plan around the way you want to move and live.</p></div><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book an appointment <i class="fas fa-arrow-right"></i></a><a href={home.site.phoneHref} class="btn btn--outline">Call {home.site.phoneDisplay}</a></div></section>
  </main>
  <footer class="site-footer"><div class="site-footer__inner"><div class="site-footer__grid"><div><a href="/" class="site-footer__logo"><img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" /></a><p>Multidisciplinary sports medicine clinics across Melbourne. Care built around your goals.</p></div><div><h5>Clinics</h5><ul><li><a href="/locations/ascot-vale/">Ascot Vale</a></li><li><a href="/locations/newport/">Newport</a></li><li><a href="/locations/bacchus-marsh/">Bacchus Marsh</a></li><li><a href="https://maps.app.goo.gl/bBiEZyTG2B6cS8ry8">Hawthorn</a></li></ul></div><div><h5>About</h5><ul><li><a href="/about/">Our clinic</a></li><li><a href="/about/team/">Meet the team</a></li><li><a href="/about/qualifications/">Qualifications</a></li></ul></div><div><h5>Contact</h5><ul><li><a href={home.site.phoneHref}>{home.site.phoneDisplay}</a></li><li><a href="/contact/">Contact us</a></li><li><a href={bookingUrl}>Book online</a></li></ul></div></div><div class="site-footer__bottom"><p>&copy; 2026 Alpha Sports Medicine.</p></div></div></footer>
  <script is:inline src="/assets/js/main.js"></script>
</body></html>
