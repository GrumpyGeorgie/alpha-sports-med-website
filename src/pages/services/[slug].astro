---
// Reusable service page. Each page is driven by src/data/services/<slug>.json (schema in
// src/data/services/README.md) and reuses the approved Osteopathy page's components.
// Osteopathy and Shockwave Therapy keep their own hand-built files.
import home from '../../data/home.json';
import FeaturedPractitioner from '../../components/FeaturedPractitioner.astro';
import SiteNavigation from '../../components/SiteNavigation.astro';
import type { ServicePage, ClinicSlug } from '../../data/services/types';

export function getStaticPaths() {
  const modules = import.meta.glob<{ default: ServicePage }>('../../data/services/*.json', { eager: true });
  return Object.entries(modules).map(([path, mod]) => {
    const slug = (path.split('/').pop() ?? '').replace('.json', '');
    return { params: { slug }, props: { page: mod.default } };
  });
}

const { page } = Astro.props as { page: ServicePage };
const { slug } = Astro.params;
const bookingUrl = home.site.bookingUrl.startsWith('#') ? `/${home.site.bookingUrl}` : home.site.bookingUrl;
const pageUrl = `https://alpha-sports-med-prototype.pages.dev/services/${slug}/`;
const schema = {'@context':'https://schema.org','@graph':[
  {'@type':'MedicalWebPage',name:page.seo.title.split('|')[0].trim(),url:pageUrl},
  {'@type':'FAQPage',mainEntity:page.faqs.map(({question,answer})=>({'@type':'Question',name:question,acceptedAnswer:{'@type':'Answer',text:answer}}))}
]};
const allClinics: Record<ClinicSlug, { name: string; address: string; image: string }> = {
  'ascot-vale': { name: 'Ascot Vale', address: '246A Union Rd, Ascot Vale', image: '/assets/images/locations/ascot-vale-storefront.jpg' },
  'newport': { name: 'Newport', address: '109 Blackshaws Rd, Newport', image: '/assets/images/locations/newport-storefront.jpg' },
  'bacchus-marsh': { name: 'Bacchus Marsh', address: '3 Graham St, Bacchus Marsh', image: '/assets/images/locations/bacchus-marsh-storefront.jpg' },
  'hawthorn': { name: 'Hawthorn', address: '1/432 Burwood Rd, Hawthorn', image: '/assets/images/locations/hawthorn-clinic.jpg' }
};
const clinics = page.clinics.map((key) => ({ key, ...allClinics[key] }));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{page.seo.title}</title>
  <meta name="description" content={page.seo.description} />
  <link rel="canonical" href={pageUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@500;700&family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" /><link rel="stylesheet" href="/assets/css/style.css?v=20260827-3" /><link rel="stylesheet" href="/assets/css/service.css?v=20260928-1" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <header class="site-header">
    <div class="site-header__inner"><a href="/" class="site-header__logo" aria-label="Alpha Sports Medicine home"><img src="/assets/images/alpha-icon.png" alt="" class="site-header__logo-icon" /><img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" class="site-header__logo-full" /></a><div class="site-header__actions"><a class="site-header__phone" href={home.site.phoneHref}><span class="site-header__phone-icon"><i class="fas fa-phone-alt" aria-hidden="true"></i></span><span class="site-header__phone-text"> {home.site.phoneDisplay}</span></a><a href={bookingUrl} class="btn btn--primary">Book online</a><button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false"><i class="fas fa-bars" aria-hidden="true"></i></button></div></div>
    <div class="site-header__nav-row"><SiteNavigation /></div>
    <SiteNavigation variant="mobile" />
  </header>
  <main>
    <section class="service-hero"><div class="service-hero__inner"><div><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/#services">Services</a><span>/</span><span>{page.breadcrumb}</span></nav><p class="eyebrow eyebrow--left">{page.hero.eyebrow}</p><h1>{page.hero.heading}</h1><p class="service-hero__subhead">{page.hero.subheading}</p><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book an appointment <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a href={home.site.phoneHref} class="btn btn--outline"><i class="fas fa-phone-alt" aria-hidden="true"></i> Call {home.site.phoneDisplay}</a></div></div><FeaturedPractitioner context="service" slug={slug} variant="hero" /></div></section>

    <section class="section service-intro"><div><div class="section-head section-head--left"><span class="section-head__ghost">MOVE</span><p class="eyebrow eyebrow--left">{page.intro.eyebrow}</p><h2>{page.intro.heading}</h2></div>{page.intro.paragraphs.map((p) => <p set:html={p} />)}</div><figure><img src={page.intro.image ?? '/assets/images/locations/hawthorn-clinic.jpg'} alt={page.intro.imageAlt ?? 'Alpha Sports Medicine practitioner providing treatment'} loading="lazy" /><figcaption><i class="fas fa-check-circle"></i> {page.intro.caption}</figcaption></figure></section>

    <section class="section section--alt service-explainer"><div class="section-head section-head--left service-explainer__heading"><span class="section-head__ghost" aria-hidden="true">WHOLE</span><p class="eyebrow eyebrow--left">{page.explainer.eyebrow}</p><h2>{page.explainer.heading}</h2>{page.explainer.concept && <div class="service-explainer__concept"><i class={`fas ${page.explainer.concept.icon}`} aria-hidden="true"></i><span><strong>{page.explainer.concept.title}</strong><small>{page.explainer.concept.copy}</small></span></div>}</div><div>{page.explainer.paragraphs.map((p) => <p set:html={p} />)}</div></section>

    <section class="section section--navy"><div class="section-head"><span class="section-head__ghost">ALPHA</span><p class="eyebrow">{page.benefits.eyebrow ?? 'How we work'}</p><h2>{page.benefits.heading}</h2><p>{page.benefits.intro}</p></div><div class="service-feature-grid">{page.benefits.items.map((b) => <article><i class={`fas ${b.icon}`}></i><h3>{b.title}</h3><p>{b.copy}</p></article>)}</div></section>

    <section class="section"><div class="section-head"><span class="section-head__ghost">SUPPORT</span><p class="eyebrow">Common reasons to visit</p><h2>{page.conditions.heading}</h2><p>{page.conditions.intro}</p></div><div class="card-grid service-condition-grid">{page.conditions.items.map((c) => <a href={c.href} class="condition-card"><span class="condition-card__icon"><i class={`fas ${c.icon}`} aria-hidden="true"></i></span><span class="condition-card__content"><span class="condition-card__label">{c.title}</span><small>{c.copy}</small></span></a>)}</div></section>

    <section class="section section--alt"><div class="section-head"><span class="section-head__ghost">VISIT</span><p class="eyebrow">What to expect</p><h2>{page.visit.heading}</h2><p>{page.visit.intro}</p></div><ol class="visit-steps">{page.visit.steps.map((step, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.copy}</p></li>)}</ol>{page.visit.notes && page.visit.notes.length > 0 && <div class="visit-notes">{page.visit.notes.map((n) => <article><i class={`fas ${n.icon}`} aria-hidden="true"></i><div><h3>{n.title}</h3><p>{n.copy}</p></div></article>)}</div>}</section>

    <section class="section service-team"><img src={page.team.image ?? '/assets/images/team/ashton-wilson.jpg'} alt={page.team.imageAlt ?? 'Alpha Sports Medicine practitioner'} loading="lazy" /><div class="service-team__copy"><p class="eyebrow eyebrow--left">{page.team.eyebrow}</p><h2>{page.team.heading}</h2><p class="service-team__description">{page.team.copy}</p><div class="btn-group"><a href="/about/team/" class="btn btn--primary">Meet the team <i class="fas fa-arrow-right"></i></a><a href="/about/qualifications/" class="btn btn--outline-navy">Our qualifications <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div></div></section>

    <section id="locations" class="section section--alt">
      <div class="section-head"><span class="section-head__ghost" aria-hidden="true">LOCATIONS</span><p class="eyebrow">Where to see us</p><h2>{page.locationsHeading}</h2></div>
      <div class="location-grid">
        {clinics.map((c) => <div class="location-card" style={`background-image: url('${c.image}');`}><span class="location-card__pin"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span><a href={`/locations/${c.key}/`} class="location-card__link" aria-label={`View ${c.name} clinic`}><i class="fas fa-external-link-alt" aria-hidden="true"></i></a><h3>{c.name}</h3><p class="location-card__address"><i class="fas fa-map-marker-alt" aria-hidden="true"></i>{c.address}</p><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book</a></div></div>)}
      </div>
      <div class="locations__footer"><p class="locations__phone"><i class="fas fa-phone-alt" aria-hidden="true"></i>One number for all clinics: {home.site.phoneDisplay}</p><a href="/locations/" class="locations__link">See all the suburbs we serve <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div>
    </section>

    <section class="section"><div class="section-head"><span class="section-head__ghost">FAQ</span><p class="eyebrow">Good to know</p><h2>{page.faqHeading}</h2></div><div class="faq__list">{page.faqs.map(({question, answer}) => <details class="faq__item"><summary><span>{question}</span></summary><div class="faq__answer"><p>{answer}</p></div></details>)}</div></section>
    <section class="section section--navy closing-cta closing-cta--osteopathy"><div class="section-head"><span class="section-head__ghost">MOVE</span><p class="eyebrow">{page.closing.eyebrow}</p><h2>{page.closing.heading}</h2><p>{page.closing.copy}</p></div><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book an appointment <i class="fas fa-arrow-right"></i></a><a href={home.site.phoneHref} class="btn btn--outline">Call {home.site.phoneDisplay}</a></div></section>
  </main>
  <footer class="site-footer"><div class="site-footer__inner"><div class="site-footer__grid"><div><a href="/" class="site-footer__logo"><img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" /></a><p>Multidisciplinary sports medicine clinics across Melbourne. Care built around your goals.</p></div><div><h5>Clinics</h5><ul><li><a href="/locations/ascot-vale/">Ascot Vale</a></li><li><a href="/locations/newport/">Newport</a></li><li><a href="/locations/bacchus-marsh/">Bacchus Marsh</a></li><li><a href="/locations/hawthorn/">Hawthorn</a></li></ul></div><div><h5>About</h5><ul><li><a href="/about/">Our clinic</a></li><li><a href="/about/team/">Meet the team</a></li><li><a href="/about/qualifications/">Qualifications</a></li></ul></div><div><h5>Contact</h5><ul><li><a href={home.site.phoneHref}>{home.site.phoneDisplay}</a></li><li><a href="/contact/">Contact us</a></li><li><a href={bookingUrl}>Book online</a></li></ul></div></div><div class="site-footer__bottom"><p>&copy; 2026 Alpha Sports Medicine.</p></div></div></footer>
  <script is:inline src="/assets/js/main.js"></script>
</body></html>
