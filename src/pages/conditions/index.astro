---
// Conditions hub (/conditions/). Copy lives in src/data/conditions-hub.json.
// Per the brief, no card may link to a page that doesn't exist: cards for pages not yet built
// render as non-clickable "page in progress" cards until their page ships.
import home from '../../data/home.json';
import page from '../../data/conditions-hub.json';
import SiteNavigation from '../../components/SiteNavigation.astro';

const builtPaths = new Set([
  ...Object.keys(import.meta.glob('/src/pages/**/index.astro')).map((p) => p.replace(/^\/src\/pages/, '').replace(/index\.astro$/, '')),
  ...Object.keys(import.meta.glob('../../data/conditions/*.json')).map((p) => `/conditions/${p.split('/').pop().replace('.json', '')}/`),
]);
const isBuilt = (href) => builtPaths.has(href);
const bookingUrl = home.site.bookingUrl.startsWith('#') ? `/${home.site.bookingUrl}` : home.site.bookingUrl;
const pageUrl = 'https://alpha-sports-med-prototype.pages.dev/conditions/';
const schema = {'@context':'https://schema.org','@graph':[
  {'@type':'CollectionPage',name:'Conditions We Treat',url:pageUrl},
  {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://alpha-sports-med-prototype.pages.dev/'},{'@type':'ListItem',position:2,name:'Conditions'}]},
  {'@type':'FAQPage',mainEntity:page.faqs.map(({question,answer})=>({'@type':'Question',name:question,acceptedAnswer:{'@type':'Answer',text:answer}}))}
]};
const locations = [
  ['Ascot Vale','246A Union Rd','/assets/images/locations/ascot-vale-storefront.jpg','/locations/ascot-vale/'],
  ['Newport','109 Blackshaws Rd','/assets/images/locations/newport-storefront.jpg','/locations/newport/'],
  ['Bacchus Marsh','3 Graham St','/assets/images/locations/bacchus-marsh-storefront.jpg','/locations/bacchus-marsh/'],
  ['Hawthorn','1/432 Burwood Rd','/assets/images/locations/hawthorn-clinic.jpg','/locations/hawthorn/']
];
---
<!doctype html><html lang="en"><head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{page.seo.title}</title>
  <meta name="description" content={page.seo.description} />
  <link rel="canonical" href={pageUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@500;700&family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" /><link rel="stylesheet" href="/assets/css/style.css?v=20260827-5" /><link rel="stylesheet" href="/assets/css/condition.css?v=20260928-2" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head><body>
  <header class="site-header"><div class="site-header__inner"><a href="/" class="site-header__logo" aria-label="Alpha Sports Medicine home"><img src="/assets/images/alpha-icon.png" alt="" class="site-header__logo-icon" /><img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" class="site-header__logo-full" /></a><div class="site-header__actions"><a class="site-header__phone" href={home.site.phoneHref}><span class="site-header__phone-icon"><i class="fas fa-phone-alt" aria-hidden="true"></i></span><span class="site-header__phone-text"> {home.site.phoneDisplay}</span></a><a href={bookingUrl} class="btn btn--primary">Book online</a><button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false"><i class="fas fa-bars" aria-hidden="true"></i></button></div></div><div class="site-header__nav-row"><SiteNavigation /></div><SiteNavigation variant="mobile" /></header>
  <main>
    <section class="condition-hero"><div class="condition-hero__inner condition-hero__inner--single"><div><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Conditions</span></nav><p class="eyebrow eyebrow--left">{page.hero.eyebrow}</p><h1>{page.hero.heading}</h1><p class="condition-hero__subhead">{page.hero.subheading}</p><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book an appointment <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a href={home.site.phoneHref} class="btn btn--outline"><i class="fas fa-phone-alt" aria-hidden="true"></i> Call {home.site.phoneDisplay}</a></div><div class="condition-trust">{page.hero.trust.map((item) => <span>{item}</span>)}</div></div></div></section>

    <section class="section section--alt wear-section"><div class="section-head section-head--left"><span class="section-head__ghost">UNSURE</span><p class="eyebrow eyebrow--left">{page.unsure.eyebrow}</p><h2>{page.unsure.heading}</h2></div><div class="wear-section__copy">{page.unsure.paragraphs.map((p) => <p set:html={p} />)}</div></section>

    <section class="section" id="browse"><div class="section-head"><span class="section-head__ghost">BROWSE</span><p class="eyebrow">Browse by area and activity</p><h2>Find the page closest to where it hurts</h2></div>
      {page.groups.map((group) => (
        <div class="hub-group" id={group.id}>
          <h3 class="hub-group__title">{group.title}</h3>
          <div class="card-grid service-condition-grid hub-grid">
            {group.items.map((item) => (
              <div class="hub-card">
                {isBuilt(item.href)
                  ? <a href={item.href} class="condition-card"><span class="condition-card__content"><span class="condition-card__label">{item.title}</span><small>{item.copy}</small></span></a>
                  : <div class="condition-card condition-card--pending" aria-disabled="true"><span class="condition-card__content"><span class="condition-card__label">{item.title}</span><small>{item.copy}</small><em class="condition-card__status">Page in progress</em></span></div>}
                {item.children && (
                  <ul class="hub-card__children">
                    {item.children.map((child) => <li>{isBuilt(child.href) ? <a href={child.href}>{child.title}</a> : <span class="is-pending">{child.title}</span>}</li>)}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="section section--navy"><div class="section-head"><span class="section-head__ghost">PLAN</span><p class="eyebrow">{page.approach.eyebrow}</p><h2>{page.approach.heading}</h2></div><ol class="knee-process hub-process">{page.approach.steps.map((step, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.copy}</p></li>)}</ol></section>

    <section class="section section--alt"><div class="section-head"><span class="section-head__ghost">TEAM</span><p class="eyebrow">Who you'll see</p><h2>{page.services.heading}</h2><p>{page.services.copy}</p></div><div class="knee-service-grid">{page.services.items.map((s) => <a href={s.href}><span><i class={`fas ${s.icon}`} aria-hidden="true"></i></span><div><h3>{s.title}</h3></div><i class="fas fa-arrow-right" aria-hidden="true"></i></a>)}</div><p class="hub-links"><a href="/about/team/">Meet the team <i class="fas fa-arrow-right" aria-hidden="true"></i></a></p></section>

    <section class="section"><div class="section-head"><span class="section-head__ghost">CLINICS</span><p class="eyebrow">Where to see us</p><h2>Four clinics across Melbourne</h2></div><div class="location-grid">{locations.map(([name, address, image, href]) => <div class="location-card" style={`background-image:url('${image}')`}><h3>{name}</h3><p class="location-card__address"><i class="fas fa-map-marker-alt"></i> {address}</p><a href={href} class="btn btn--primary">View clinic</a></div>)}</div></section>

    <section class="section section--alt"><div class="section-head"><span class="section-head__ghost">FAQ</span><p class="eyebrow">Common questions</p><h2>Before your first visit</h2></div><div class="faq__list">{page.faqs.map(({question, answer}) => <details class="faq__item"><summary><span>{question}</span></summary><div class="faq__answer"><p>{answer}</p></div></details>)}</div></section>
    <section class="section section--navy closing-cta closing-cta--knee"><div class="section-head"><span class="section-head__ghost">MOVE</span><p class="eyebrow">{page.closing.eyebrow}</p><h2>{page.closing.heading}</h2><p class="closing-cta__copy">{page.closing.copy}</p></div><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book an appointment <i class="fas fa-arrow-right"></i></a><a href={home.site.phoneHref} class="btn btn--outline">Call {home.site.phoneDisplay}</a><a href="/contact/" class="btn btn--outline">Describe the problem</a></div></section>
  </main>
  <footer class="site-footer"><div class="site-footer__inner"><div class="site-footer__grid"><div><a href="/" class="site-footer__logo"><img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" /></a><p>Multidisciplinary sports medicine clinics across Melbourne. Care built around your goals.</p></div><div><h5>Clinics</h5><ul><li><a href="/locations/ascot-vale/">Ascot Vale</a></li><li><a href="/locations/newport/">Newport</a></li><li><a href="/locations/bacchus-marsh/">Bacchus Marsh</a></li><li><a href="/locations/hawthorn/">Hawthorn</a></li></ul></div><div><h5>About</h5><ul><li><a href="/about/">Our clinic</a></li><li><a href="/about/team/">Meet the team</a></li><li><a href="/about/qualifications/">Qualifications</a></li></ul></div><div><h5>Contact</h5><ul><li><a href={home.site.phoneHref}>{home.site.phoneDisplay}</a></li><li><a href="/contact/">Contact us</a></li><li><a href={bookingUrl}>Book online</a></li></ul></div></div><div class="site-footer__bottom"><p>&copy; 2026 Alpha Sports Medicine.</p></div></div></footer>
  <script is:inline src="/assets/js/main.js"></script>
</body></html>
