---
import home from '../../../data/home.json';
const bookingUrl = home.site.bookingUrl.startsWith('#') ? `/${home.site.bookingUrl}` : home.site.bookingUrl;
const regions = [
  ['Front of the knee', 'Stairs, hills, squats or sitting', 'Pain around the kneecap is common in runners and active adults. It often appears when a recent increase in running, hills or gym work exceeds what the knee currently tolerates.'],
  ['Below the kneecap', 'Jumping, landing or the morning after', 'A very localised sore spot in the tendon below the kneecap can behave like patellar tendinopathy. It usually needs carefully progressed loading rather than complete rest.'],
  ['Inside the knee', 'Walking, twisting or getting out of the car', 'Pain along the inside joint line may relate to several structures, including an irritated meniscus, ligament or osteoarthritis. An assessment helps separate them.'],
  ['Outside the knee', 'A consistent point during a run or ride', 'Outside knee pain is common in runners and cyclists. Training load and movement patterns are considered together rather than blaming one tight structure.'],
  ['Behind the knee', 'Bending, straightening or swelling', 'Tightness or fullness behind the knee can have several causes, including a Baker’s cyst. New or unexplained swelling should be assessed.']
];
const process = [
  ['01','Start with your story','What changed, what you have tried and what the knee has stopped you doing.'],
  ['02','Assess the whole chain','We examine the knee and how the hip, ankle and foot influence its workload.'],
  ['03','Explain it clearly','You leave understanding what we think is happening and what comes next.'],
  ['04','Settle what is irritable','Hands-on care may help symptoms while we introduce suitable movement.'],
  ['05','Build capacity','Progressive strength for the quadriceps, hips and calves is central for many presentations.'],
  ['06','Return to your goal','Running, stairs, squats, gardening or keeping up with the grandkids—the plan returns to real life.']
];
const services = [
  ['Physiotherapy','Movement assessment and progressive rehabilitation.','/services/physiotherapy/','fa-user-md'],
  ['Exercise physiology','Supervised exercise for strength, function and confidence.','/services/exercise-physiology/','fa-heartbeat'],
  ['Osteopathy','Hands-on treatment connected with a practical loading plan.','/services/osteopathy/','fa-hands'],
  ['Clinical Pilates','Practitioner-guided movement for the strength phase.','/services/clinical-pilates/','fa-child'],
  ['Strength and conditioning','A pathway back to training and higher physical demands.','/services/strength-conditioning/','fa-dumbbell']
];
const related = [
  ['ACL injuries','/conditions/sports-injuries/acl-injury/'],['Tendon pain','/conditions/tendonitis-tendinopathy/'],['Hip pain','/conditions/hip-pain/'],['Foot pain','/conditions/foot-pain-plantar-fasciitis/'],['Running injuries','/conditions/running-injuries/'],['Running assessment','/running-assessment/']
];
const faqs = [
  ['Why does my knee hurt going down stairs?', 'Going downstairs asks the front of the knee to manage a relatively high load. Pain can appear when that demand exceeds current capacity, particularly after changes in running, hills, gym work or time away from activity.'],
  ['Why does my knee hurt after sitting?', 'A sore or stiff knee after sitting is common with kneecap-related pain and osteoarthritis. The pattern is useful information, but it does not identify one diagnosis by itself.'],
  ['Should I stop running with knee pain?', 'Not always. Many people can temporarily adjust distance, hills, speed or frequency while building capacity. Sudden swelling, instability, locking or an inability to bear weight needs assessment first.'],
  ['Are squats bad for my knees?', 'Squatting is not automatically harmful. Range, load, technique and current tolerance all matter. An assessed, gradually progressed squat can be part of rehabilitation rather than something permanently avoided.'],
  ['Do I need a scan?', 'Many knee presentations can be assessed clinically first. Imaging may be useful after significant trauma, when serious injury is suspected, or when the result would change management.'],
  ['Can exercise help knee osteoarthritis?', 'Australian clinical guidance recommends individualised land-based exercise for knee osteoarthritis to improve pain and function. The right starting point and progression depend on the individual.'],
  ['Do I need a knee replacement?', 'That decision belongs with you and your surgeon. Replacement can be effective for advanced osteoarthritis that has not responded to conservative care; exercise and load management are commonly explored first.'],
  ['Do I need a referral?', 'No. You can book directly. If you have a GP care plan, WorkCover or TAC claim, mention it when booking so the team can guide you.'],
  ['How long does knee rehabilitation take?', 'Knee rehabilitation is usually measured in weeks to months, not days. The timeframe depends on the cause, how long symptoms have been present, your starting capacity and the goal you are returning to.']
];
const schema = {'@context':'https://schema.org','@graph':[{'@type':'MedicalWebPage',name:'Knee Pain Treatment Melbourne',url:'https://alpha-sports-med-prototype.pages.dev/conditions/knee-pain/',about:{'@type':'MedicalCondition',name:'Knee pain'}},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://alpha-sports-med-prototype.pages.dev/'},{'@type':'ListItem',position:2,name:'Conditions',item:'https://alpha-sports-med-prototype.pages.dev/#conditions'},{'@type':'ListItem',position:3,name:'Knee Pain'}]},{'@type':'FAQPage',mainEntity:faqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))}]};
---
<!doctype html><html lang="en"><head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Knee Pain Treatment Melbourne | Alpha Sports Medicine</title>
  <meta name="description" content="Knee pain on stairs, running or squatting? Knees respond to appropriate loading, not rest alone. Assessment and rehabilitation across Melbourne." />
  <link rel="canonical" href="https://alpha-sports-med-prototype.pages.dev/conditions/knee-pain/" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@500;700&family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" /><link rel="stylesheet" href="/assets/css/style.css?v=20260827-5" /><link rel="stylesheet" href="/assets/css/condition.css?v=20260827-1" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head><body>
  <header class="site-header"><div class="site-header__inner"><a href="/" class="site-header__logo" aria-label="Alpha Sports Medicine home"><img src="/assets/images/alpha-icon.png" alt="" class="site-header__logo-icon" /><img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" class="site-header__logo-full" /></a><div class="site-header__actions"><a class="site-header__phone" href={home.site.phoneHref}><span class="site-header__phone-icon"><i class="fas fa-phone-alt" aria-hidden="true"></i></span><span class="site-header__phone-text"> {home.site.phoneDisplay}</span></a><a href={bookingUrl} class="btn btn--primary">Book online</a><button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false"><i class="fas fa-bars" aria-hidden="true"></i></button></div></div><div class="site-header__nav-row"><nav class="site-header__nav" aria-label="Primary"><a href="/">Home</a><a href="/about/">Meet Us</a><a href="/#services">What We Do</a><a href="/#who-we-support">Who We Support</a><a href="/#conditions" aria-current="page">Conditions</a><a href="/#getting-started">Getting Started</a><a href="/#locations">Locations</a><a href="/contact/">Contact Us</a></nav></div><nav class="mobile-nav" aria-label="Mobile"><a href="/">Home</a><a href="/about/">Meet Us</a><a href="/#services">What We Do</a><a href="/#conditions">Conditions</a><a href="/#locations">Locations</a><a href="/contact/">Contact Us</a></nav></header>
  <main>
    <section class="condition-hero"><div class="condition-hero__inner"><div><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/#conditions">Conditions</a><span>/</span><span>Knee pain</span></nav><p class="eyebrow eyebrow--left">Knee pain treatment · Melbourne</p><h1>Knee pain does not have to mean stopping</h1><p class="condition-hero__subhead">Knees respond to being loaded appropriately—not protected forever. We work out what is driving the pain and build back what your knee can tolerate.</p><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book an appointment <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a href={home.site.phoneHref} class="btn btn--outline"><i class="fas fa-phone-alt" aria-hidden="true"></i> Call {home.site.phoneDisplay}</a></div><div class="condition-trust"><span>No referral needed</span><span>Four Melbourne clinics</span><span>Health fund claiming</span></div></div><aside class="urgent-card"><span class="urgent-card__icon"><i class="fas fa-exclamation" aria-hidden="true"></i></span><div><p class="eyebrow eyebrow--left">When to seek urgent care</p><h2>Some knee symptoms need medical assessment first</h2><p>Seek urgent care if you cannot bear weight, the knee is badly swollen or deformed after an injury, or it is hot and red and you have a fever. A knee that locks or repeatedly gives way should also be assessed promptly.</p><a href="https://www.healthdirect.gov.au/knee-pain" target="_blank" rel="noopener noreferrer">Read Healthdirect guidance <i class="fas fa-external-link-alt" aria-hidden="true"></i></a></div></aside></div></section>

    <section class="section"><div class="section-head"><span class="section-head__ghost">WHERE</span><p class="eyebrow">Start with the pattern</p><h2>Where does your knee hurt?</h2><p>The location and activity that trigger pain provide useful clues. They are a starting point—not a diagnosis.</p></div><div class="knee-region-grid">{regions.map(([title,kicker,copy],i)=><article><span class="knee-region__number">0{i+1}</span><h3>{title}</h3><strong>{kicker}</strong><p>{copy}</p>{i===1&&<a href="/conditions/tendonitis-tendinopathy/">Learn about tendon pain <i class="fas fa-arrow-right" aria-hidden="true"></i></a>}</article>)}</div></section>

    <section class="section section--alt wear-section"><div class="section-head section-head--left"><span class="section-head__ghost">LOAD</span><p class="eyebrow eyebrow--left">A better explanation</p><h2>“Wear and tear” is not the whole story</h2></div><div class="wear-section__copy"><p>An X-ray may show osteoarthritis, but it does not tell the whole story of what you can do or how much pain you must have. Your symptoms are real, and the image is only one part of the assessment.</p><p>The “wearing out” metaphor can make movement sound like damage. A more useful view is that joints are living tissue and the body responds to suitable, gradually progressed load. Australian guidance recommends individualised land-based exercise for people with knee osteoarthritis to improve pain and function.</p><p>That does not mean surgery is never appropriate or that exercise reverses arthritis. It means walking, strengthening and practical load management deserve a genuine place in the conversation before the future of the knee is decided.</p><a href="https://www.racgp.org.au/clinical-resources/clinical-guidelines/key-racgp-guidelines/view-all-racgp-guidelines/knee-and-hip-osteoarthritis/summary-of-recommendations/strong-recommendations-for-the-intervention" target="_blank" rel="noopener noreferrer" class="text-link">Read the RACGP recommendation <i class="fas fa-external-link-alt" aria-hidden="true"></i></a></div></section>

    <section class="section active-section"><div><p class="eyebrow eyebrow--left">For runners and gym-goers</p><h2>The load changed before the knee did</h2><p>Pain often follows more mileage, new hills, a return after a break, a new gym program or more intensity packed into the same week. “Weak glutes” may be one contributor, but it rarely explains the timing by itself.</p><p>Knees moving over toes and deeper squats are not automatically dangerous. Range and load can be modified temporarily, then progressed as capacity improves. Running cadence, mechanics or footwear may matter for some people, but no single fix replaces a well-built rehabilitation plan.</p><a href="/running-assessment/" class="btn btn--outline-navy">Explore running assessments <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div><figure><img src="/assets/images/locations/hawthorn-clinic.jpg" alt="Alpha Sports Medicine practitioner guiding a patient through movement" loading="lazy" /><figcaption><i class="fas fa-sliders-h" aria-hidden="true"></i> Modify the load. Keep the goal.</figcaption></figure></section>

    <section class="section section--navy"><div class="section-head"><span class="section-head__ghost">PLAN</span><p class="eyebrow">How we treat knee pain</p><h2>A plan that returns to real life</h2></div><ol class="knee-process">{process.map(([number,title,copy])=><li><span>{number}</span><h3>{title}</h3><p>{copy}</p></li>)}</ol></section>

    <section class="section surgery-section"><div class="surgery-section__icon"><i class="fas fa-notes-medical" aria-hidden="true"></i></div><div><p class="eyebrow eyebrow--left">A balanced conversation</p><h2>When surgery is part of the picture</h2><p>Knee replacement can be effective for advanced osteoarthritis that has not responded to conservative management. The order matters: individualised exercise and load management are commonly considered first, and every surgical decision belongs to you and your surgeon.</p><p>When surgery is the right step, structured rehabilitation can help before and after the procedure. For significant injuries, we can also coordinate with your GP, imaging provider or specialist.</p></div></section>

    <section class="section section--alt"><div class="section-head"><span class="section-head__ghost">TEAM</span><p class="eyebrow">Who you may see</p><h2>Hands-on care and exercise working together</h2></div><div class="knee-service-grid">{services.map(([title,copy,href,icon])=><a href={href}><span><i class={`fas ${icon}`} aria-hidden="true"></i></span><div><h3>{title}</h3><p>{copy}</p></div><i class="fas fa-arrow-right" aria-hidden="true"></i></a>)}</div></section>

    <section class="section"><div class="section-head"><span class="section-head__ghost">MORE</span><p class="eyebrow">Related support</p><h2>Explore connected concerns</h2></div><div class="related-grid">{related.map(([title,href])=><a href={href}>{title}<i class="fas fa-arrow-right" aria-hidden="true"></i></a>)}</div></section>

    <section class="section section--alt"><div class="section-head"><span class="section-head__ghost">CLINICS</span><p class="eyebrow">Knee pain treatment in Melbourne</p><h2>See the team close to home</h2></div><div class="location-grid"><div class="location-card" style="background-image:url('/assets/images/locations/ascot-vale-storefront.jpg')"><h3>Ascot Vale</h3><p class="location-card__address"><i class="fas fa-map-marker-alt"></i> 246A Union Rd</p><a href="/locations/ascot-vale/" class="btn btn--primary">View clinic</a></div><div class="location-card" style="background-image:url('/assets/images/locations/newport-storefront.jpg')"><h3>Newport</h3><p class="location-card__address"><i class="fas fa-map-marker-alt"></i> 109 Blackshaws Rd</p><a href="/locations/newport/" class="btn btn--primary">View clinic</a></div><div class="location-card" style="background-image:url('/assets/images/locations/bacchus-marsh-storefront.jpg')"><h3>Bacchus Marsh</h3><p class="location-card__address"><i class="fas fa-map-marker-alt"></i> 3 Graham St</p><a href="/locations/bacchus-marsh/" class="btn btn--primary">View clinic</a></div><div class="location-card" style="background-image:url('/assets/images/locations/hawthorn-clinic.jpg')"><h3>Hawthorn</h3><p class="location-card__address"><i class="fas fa-map-marker-alt"></i> 432 Burwood Rd</p><a href="https://maps.app.goo.gl/bBiEZyTG2B6cS8ry8" class="btn btn--primary">View on Maps</a></div></div></section>

    <section class="section"><div class="section-head"><span class="section-head__ghost">FAQ</span><p class="eyebrow">Common questions</p><h2>Knee pain FAQs</h2></div><div class="faq__list">{faqs.map(([q,a])=><details class="faq__item"><summary><span>{q}</span></summary><div class="faq__answer"><p>{a}</p></div></details>)}</div></section>
    <section class="section section--navy closing-cta"><div class="section-head"><span class="section-head__ghost">MOVE</span><p class="eyebrow">Your next step</p><h2>What have you stopped doing because of your knee?</h2><p class="closing-cta__copy">Tell us what you want to get back to. We will assess the knee, explain the options and build the next step with you.</p></div><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book an appointment <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a href={home.site.phoneHref} class="btn btn--outline">Call {home.site.phoneDisplay}</a></div></section>
  </main>
  <footer class="site-footer"><div class="site-footer__inner"><div class="site-footer__grid"><div><a href="/" class="site-footer__logo"><img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" /></a><p>Multidisciplinary sports medicine clinics across Melbourne. Care built around your goals.</p></div><div><h5>Clinics</h5><ul><li><a href="/locations/ascot-vale/">Ascot Vale</a></li><li><a href="/locations/newport/">Newport</a></li><li><a href="/locations/bacchus-marsh/">Bacchus Marsh</a></li><li><a href="https://maps.app.goo.gl/bBiEZyTG2B6cS8ry8">Hawthorn</a></li></ul></div><div><h5>About</h5><ul><li><a href="/about/">Our clinic</a></li><li><a href="/about/team/">Meet the team</a></li><li><a href="/about/qualifications/">Qualifications</a></li></ul></div><div><h5>Contact</h5><ul><li><a href={home.site.phoneHref}>{home.site.phoneDisplay}</a></li><li><a href="/contact/">Contact us</a></li><li><a href={bookingUrl}>Book online</a></li></ul></div></div><div class="site-footer__bottom"><p>&copy; 2026 Alpha Sports Medicine.</p></div></div></footer>
  <script is:inline src="/assets/js/main.js"></script>
</body></html>
