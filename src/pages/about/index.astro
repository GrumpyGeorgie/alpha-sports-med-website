---
import about from '../../data/about.json';
import home from '../../data/home.json';
import SiteNavigation from '../../components/SiteNavigation.astro';

const bookingUrl = home.site.bookingUrl.startsWith('#') ? `/${home.site.bookingUrl}` : home.site.bookingUrl;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{about.seo.title}</title>
    <meta name="description" content={about.seo.description} />
    <link rel="canonical" href="https://alpha-sports-med-prototype.pages.dev/about/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@500;700&family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="stylesheet" href="/assets/css/style.css?v=20260825-1" />
    <link rel="stylesheet" href="/assets/css/about.css?v=20260825-1" />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="site-header__logo" aria-label="Alpha Sports Medicine home">
          <img src="/assets/images/alpha-icon.png" alt="" class="site-header__logo-icon" />
          <img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" class="site-header__logo-full" />
        </a>
        <div class="site-header__actions">
          <a class="site-header__phone" href={home.site.phoneHref} aria-label={`Call ${home.site.phoneDisplay}`}>
            <span class="site-header__phone-icon"><i class="fas fa-phone-alt" aria-hidden="true"></i></span>
            <span class="site-header__phone-text"> {home.site.phoneDisplay}</span>
          </a>
          <a href={bookingUrl} class="btn btn--primary">Book online</a>
          <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
            <i class="fas fa-bars" aria-hidden="true"></i>
          </button>
        </div>
      </div>
      <div class="site-header__nav-row">
        <SiteNavigation />
      </div>
      <SiteNavigation variant="mobile" />
    </header>

    <main>
      <section class="about-hero">
        <div class="about-hero__inner">
          <div class="about-hero__copy">
            <nav class="breadcrumbs" aria-label="Breadcrumb">
              <a href="/">Home</a><span aria-hidden="true">/</span><span>About</span>
            </nav>
            <p class="eyebrow eyebrow--left">{about.hero.eyebrow}</p>
            <h1>{about.hero.heading}</h1>
            <p class="about-hero__subhead">{about.hero.subheading}</p>
            <div class="btn-group">
              <a href={bookingUrl} class="btn btn--primary">Book an appointment <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
              <a href="/about/team/" class="btn btn--outline">Meet the team</a>
            </div>
          </div>
          <div class="about-hero__panel" aria-label="Alpha Sports Medicine at a glance">
            <div class="about-stat">
              <i class="fas fa-calendar-check" aria-hidden="true"></i>
              <strong>2017</strong>
              <span>Established</span>
            </div>
            <div class="about-stat">
              <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
              <strong>4</strong>
              <span>Melbourne clinics</span>
            </div>
            <div class="about-stat">
              <i class="fas fa-user-md" aria-hidden="true"></i>
              <strong>10</strong>
              <span>Connected disciplines</span>
            </div>
            <div class="about-stat">
              <i class="fas fa-link" aria-hidden="true"></i>
              <strong>1</strong>
              <span>Coordinated approach</span>
            </div>
          </div>
        </div>
      </section>

      <section class="section about-overview">
        <div class="about-overview__copy">
          <div class="section-head section-head--left about-overview__head">
            <span class="section-head__ghost" aria-hidden="true">TEAM</span>
            <p class="eyebrow eyebrow--left">{about.overview.eyebrow}</p>
            <h2>{about.overview.heading}</h2>
          </div>
          {about.overview.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <div class="btn-group about-overview__actions">
            <a class="btn btn--primary" href="/#services">Explore our services <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
          </div>
        </div>
        <div class="about-overview__visual">
          <img src="/assets/images/hero-bg-2.webp" alt="Alpha Sports Medicine practitioner in the clinic" loading="lazy" />
          <div class="about-overview__badge"><i class="fas fa-users" aria-hidden="true"></i><span>One team working around your goals</span></div>
        </div>
      </section>

      <section class="section section--alt about-values">
        <div class="section-head">
          <span class="section-head__ghost" aria-hidden="true">VALUES</span>
          <p class="eyebrow">What guides us</p>
          <h2>Professional care should still feel personal</h2>
          <p>Our values are reflected in how we listen, explain, collaborate and follow through.</p>
        </div>
        <div class="about-values__grid">
          {about.values.map((value) => (
            <article class="about-value-card">
              <span class="about-value-card__icon"><i class={`fas ${value.icon}`} aria-hidden="true"></i></span>
              <h3>{value.title}</h3>
              <p>{value.copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section about-approach">
        <div class="section-head">
          <span class="section-head__ghost" aria-hidden="true">APPROACH</span>
          <p class="eyebrow">How we work</p>
          <h2>A clear, collaborative care experience</h2>
        </div>
        <ol class="about-approach__grid">
          {about.approach.map((item) => (
            <li class="about-approach-card">
              <span>{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="section section--navy about-leadership">
        <div class="about-leadership__image">
          <img src="/assets/images/team/ashton-wilson.jpg" alt="Dr Ashton Wilson, Alpha Sports Medicine founder and osteopath" loading="lazy" />
        </div>
        <div class="about-leadership__copy">
          <div class="section-head section-head--left about-leadership__head">
            <span class="section-head__ghost" aria-hidden="true">LEADERSHIP</span>
            <p class="eyebrow eyebrow--left">Leadership and culture</p>
            <h2>{about.leadership.heading}</h2>
          </div>
          <p>{about.leadership.copy}</p>
          <a href="/about/team/" class="btn btn--primary">Meet our practitioners <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
        </div>
      </section>

      <section id="locations" class="section section--alt about-locations">
        <div class="section-head">
          <span class="section-head__ghost" aria-hidden="true">LOCATIONS</span>
          <p class="eyebrow">Across Melbourne</p>
          <h2>Four clinics across Melbourne</h2>
        </div>
        <div class="location-grid">
          <div class="location-card" style="background-image: url('/assets/images/locations/ascot-vale-storefront.jpg');">
            <span class="location-card__pin"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span>
            <a href="/locations/ascot-vale/" class="location-card__link" aria-label="View Ascot Vale clinic"><i class="fas fa-external-link-alt" aria-hidden="true"></i></a>
            <h3>Ascot Vale</h3>
            <p class="location-card__address"><i class="fas fa-map-marker-alt" aria-hidden="true"></i>246A Union Rd, Ascot Vale</p>
            <div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book</a></div>
          </div>
          <div class="location-card" style="background-image: url('/assets/images/locations/newport-storefront.jpg');">
            <span class="location-card__pin"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span>
            <a href="/locations/newport/" class="location-card__link" aria-label="View Newport clinic"><i class="fas fa-external-link-alt" aria-hidden="true"></i></a>
            <h3>Newport</h3>
            <p class="location-card__address"><i class="fas fa-map-marker-alt" aria-hidden="true"></i>109 Blackshaws Rd, Newport</p>
            <div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book</a></div>
          </div>
          <div class="location-card" style="background-image: url('/assets/images/locations/bacchus-marsh-storefront.jpg');">
            <span class="location-card__pin"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span>
            <a href="/locations/bacchus-marsh/" class="location-card__link" aria-label="View Bacchus Marsh clinic"><i class="fas fa-external-link-alt" aria-hidden="true"></i></a>
            <h3>Bacchus Marsh</h3>
            <p class="location-card__address"><i class="fas fa-map-marker-alt" aria-hidden="true"></i>3 Graham St, Bacchus Marsh</p>
            <div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book</a></div>
          </div>
          <div class="location-card location-card--hawthorn">
            <span class="location-card__pin"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span>
            <a href="https://maps.app.goo.gl/bBiEZyTG2B6cS8ry8" target="_blank" rel="noopener noreferrer" class="location-card__link" aria-label="View Hawthorn clinic on Google Maps"><i class="fas fa-external-link-alt" aria-hidden="true"></i></a>
            <h3>Hawthorn</h3>
            <p class="location-card__address"><i class="fas fa-map-marker-alt" aria-hidden="true"></i>432 Burwood Rd, Hawthorn VIC 3122</p>
            <div class="btn-group"><a href="https://maps.app.goo.gl/bBiEZyTG2B6cS8ry8" target="_blank" rel="noopener noreferrer" class="btn btn--primary">View on Maps</a></div>
          </div>
        </div>
        <div class="locations__footer">
          <p class="locations__phone"><i class="fas fa-phone-alt" aria-hidden="true"></i>One number for all four: {home.site.phoneDisplay}</p>
          <a href="/locations/" class="locations__link">See all the suburbs we serve <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
        </div>
      </section>

      <section class="section section--navy closing-cta closing-cta--about">
        <div class="section-head closing-cta__head">
          <span class="section-head__ghost" aria-hidden="true">NEXT</span>
          <p class="eyebrow">{about.closing.eyebrow}</p>
          <h2>{about.closing.heading}</h2>
          <p class="closing-cta__copy">{about.closing.copy}</p>
        </div>
        <div class="btn-group">
          <a href={bookingUrl} class="btn btn--primary">Book online <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
          <a href="/contact/" class="btn btn--outline">Contact us</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__grid">
          <div>
            <a href="/" class="site-footer__logo"><img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" /></a>
            <p>Multidisciplinary sports medicine clinics across Melbourne. Care built around your goals.</p>
          </div>
          <div><h5>Clinics</h5><ul><li><a href="/locations/ascot-vale/">Ascot Vale</a></li><li><a href="/locations/newport/">Newport</a></li><li><a href="/locations/bacchus-marsh/">Bacchus Marsh</a></li><li><a href="https://maps.app.goo.gl/bBiEZyTG2B6cS8ry8">Hawthorn</a></li></ul></div>
          <div><h5>About</h5><ul><li><a href="/about/">Our clinic</a></li><li><a href="/about/team/">Meet the team</a></li><li><a href="/about/qualifications/">Qualifications</a></li><li><a href="/about/community/">Community</a></li></ul></div>
          <div><h5>Contact</h5><ul><li><a href={home.site.phoneHref}><i class="fas fa-phone-alt" aria-hidden="true"></i> {home.site.phoneDisplay}</a></li><li><a href="/contact/">Contact us</a></li><li><a href={bookingUrl}>Book online</a></li></ul></div>
        </div>
        <div class="site-footer__bottom"><p>&copy; 2026 Alpha Sports Medicine. All rights reserved.</p></div>
      </div>
    </footer>
    <script is:inline src="/assets/js/main.js"></script>
  </body>
</html>
