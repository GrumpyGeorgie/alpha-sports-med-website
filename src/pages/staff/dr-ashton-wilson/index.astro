---
import home from '../../../data/home.json';

const bookingUrl = home.site.bookingUrl.startsWith('#') ? `/${home.site.bookingUrl}` : home.site.bookingUrl;
const interests = [
  { icon: 'fa-link', title: 'Hypermobility, EDS and HSD', copy: 'Support for joint instability, persistent pain, fatigue and building capacity in a way that respects a hypermobile body.' },
  { icon: 'fa-running', title: 'Sport and rehabilitation', copy: 'A practical path from pain or injury back to training, performance and the activities that matter to you.' },
  { icon: 'fa-head-side-virus', title: 'Foot, ankle and jaw concerns', copy: 'Assessment and care for recurring foot and ankle issues, TMJ discomfort, jaw tension and related movement patterns.' }
];
const qualifications = [
  'Bachelor of Biomedical Science — Anatomy and Physiology',
  'Bachelor of Clinical Science',
  'Master of Osteopathy',
  'ASCA Level 1 Strength and Conditioning Coach',
  'Kinetic Link Training certification'
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Dr Ashton Wilson',
  jobTitle: 'Osteopath, Strength and Rehabilitation Coach, and Founder',
  worksFor: { '@type': 'MedicalOrganization', name: 'Alpha Sports Medicine' },
  url: 'https://alpha-sports-med-prototype.pages.dev/staff/dr-ashton-wilson/',
  image: 'https://alpha-sports-med-prototype.pages.dev/assets/images/team/ashton-wilson.jpg',
  knowsAbout: ['Osteopathy', 'Strength and rehabilitation', 'Hypermobility Spectrum Disorder', 'Ehlers-Danlos Syndrome', 'Sports rehabilitation']
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dr Ashton Wilson | Osteopath in Newport | Alpha Sports Medicine</title>
  <meta name="description" content="Meet Dr Ashton Wilson, Newport osteopath, rehabilitation coach and founder of Alpha Sports Medicine, with a special interest in hypermobility, EDS and HSD." />
  <link rel="canonical" href="https://alpha-sports-med-prototype.pages.dev/staff/dr-ashton-wilson/" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@500;700&family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
  <link rel="stylesheet" href="/assets/css/style.css?v=20260827-4" />
  <link rel="stylesheet" href="/assets/css/staff.css?v=20260827-6" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <header class="site-header">
    <div class="site-header__inner">
      <a href="/" class="site-header__logo" aria-label="Alpha Sports Medicine home"><img src="/assets/images/alpha-icon.png" alt="" class="site-header__logo-icon" /><img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" class="site-header__logo-full" /></a>
      <div class="site-header__actions"><a class="site-header__phone" href={home.site.phoneHref} aria-label={`Call ${home.site.phoneDisplay}`}><span class="site-header__phone-icon"><i class="fas fa-phone-alt" aria-hidden="true"></i></span><span class="site-header__phone-text"> {home.site.phoneDisplay}</span></a><a href={bookingUrl} class="btn btn--primary">Book online</a><button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false"><i class="fas fa-bars" aria-hidden="true"></i></button></div>
    </div>
    <div class="site-header__nav-row"><nav class="site-header__nav" aria-label="Primary"><a href="/">Home</a><a href="/about/" aria-current="page">Meet Us</a><a href="/#services">What We Do</a><a href="/#who-we-support">Who We Support</a><a href="/#conditions">Conditions</a><a href="/#getting-started">Getting Started</a><a href="/#locations">Locations</a><a href="/contact/">Contact Us</a></nav></div>
    <nav class="mobile-nav" aria-label="Mobile"><a href="/">Home</a><a href="/about/">Meet Us</a><a href="/#services">What We Do</a><a href="/#conditions">Conditions</a><a href="/#locations">Locations</a><a href="/contact/">Contact Us</a></nav>
  </header>

  <main>
    <section class="staff-hero">
      <div class="staff-hero__inner">
        <div class="staff-hero__portrait"><img src="/assets/images/team/ashton-wilson.jpg" alt="Dr Ashton Wilson, osteopath and founder of Alpha Sports Medicine" /></div>
        <div class="staff-hero__copy">
          <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/about/team/">Team</a><span aria-hidden="true">/</span><span>Dr Ashton Wilson</span></nav>
          <p class="eyebrow eyebrow--left">Newport osteopath · Founder</p>
          <h1>Dr Ashton Wilson</h1>
          <p class="staff-hero__role">Osteopath, strength and rehabilitation coach, educator and founder of Alpha Sports Medicine.</p>
          <p class="staff-hero__intro">Ashton works with people navigating complex musculoskeletal concerns, sporting injuries and hypermobility. Her approach combines clear explanations, hands-on osteopathic care and progressive rehabilitation.</p>
          <div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book with Ashton <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a href={home.site.phoneHref} class="btn btn--outline"><i class="fas fa-phone-alt" aria-hidden="true"></i> Call {home.site.phoneDisplay}</a></div>
          <ul class="staff-hero__facts" aria-label="At a glance"><li><i class="fas fa-map-marker-alt" aria-hidden="true"></i><span><strong>Newport</strong>In-clinic appointments</span></li><li><i class="fas fa-laptop-medical" aria-hidden="true"></i><span><strong>Online care</strong>Australia-wide support</span></li><li><i class="fas fa-calendar-check" aria-hidden="true"></i><span><strong>10+ years</strong>Clinical experience</span></li></ul>
        </div>
      </div>
    </section>

    <section class="section staff-intro">
      <div class="section-head section-head--left"><span class="section-head__ghost" aria-hidden="true">CARE</span><p class="eyebrow eyebrow--left">How Ashton works</p><h2>Thoughtful care for complex presentations</h2></div>
      <div class="staff-intro__copy"><p>Ashton begins by understanding the whole picture: what you are feeling, what you have tried, how you move and what you want to return to. Treatment is explained clearly and shaped with you, not handed to you as a generic plan.</p><p>Her background in strength and conditioning helps connect treatment in the clinic with the capacity you need outside it. The aim is to help you understand your body, build confidence and make useful progress towards your goals.</p></div>
    </section>

    <section class="section section--alt">
      <div class="section-head staff-interests__head"><span class="section-head__ghost" aria-hidden="true">FOCUS</span><p class="eyebrow">Clinical interests</p><h2>Areas Ashton commonly works with</h2><p>Care is always based on the individual assessment rather than a diagnosis alone.</p></div>
      <div class="staff-interest-grid">{interests.map((interest) => <article class="staff-interest-card"><span><i class={`fas ${interest.icon}`} aria-hidden="true"></i></span><h3>{interest.title}</h3><p>{interest.copy}</p></article>)}</div>
    </section>

    <section class="section section--navy staff-hypermobility">
      <div class="staff-hypermobility__inner">
        <div><div class="section-head section-head--left staff-hypermobility__head"><span class="section-head__ghost" aria-hidden="true">SUPPORT</span><p class="eyebrow eyebrow--left">Hypermobility, EDS and HSD</p><h2>Building control, confidence and capacity</h2></div><p>Hypermobility can involve far more than flexible joints. Ashton works with people managing instability, recurring pain, fatigue and exercise intolerance, using education, appropriate hands-on care and carefully progressed rehabilitation.</p><p>She is also involved in teaching and mentoring health professionals who want to improve their clinical reasoning and exercise prescription for hypermobile presentations.</p></div>
        <aside class="staff-hypermobility__panel"><h3>Care may focus on</h3><ul><li>Understanding symptoms and contributing factors</li><li>Improving joint control and proprioception</li><li>Safe, progressive strength and load tolerance</li><li>Pacing, recovery and practical self-management</li></ul></aside>
      </div>
    </section>

    <section class="section staff-credentials">
      <div><div class="section-head section-head--left"><span class="section-head__ghost" aria-hidden="true">STUDY</span><p class="eyebrow eyebrow--left">Qualifications</p><h2>A foundation in osteopathy and rehabilitation</h2></div><ul class="staff-credentials__list">{qualifications.map((qualification) => <li><i class="fas fa-check" aria-hidden="true"></i><span>{qualification}</span></li>)}</ul></div>
      <div class="staff-experience"><p class="eyebrow eyebrow--left">Sporting experience</p><h2>From the clinic to high-performance sport</h2><p>Ashton’s background includes clinical, rehabilitation and game-day roles across professional and high-level sporting environments. That experience informs a practical understanding of training demands, injury, return-to-play decisions and the frustration of being sidelined.</p><div class="staff-experience__clubs"><span>Williamstown Football Club</span><span>Collingwood Football Club</span><span>Victorian Thunderbolts</span><span>Southport Sharks</span><span>Burleigh Bears</span></div></div>
    </section>

    <section class="section section--alt staff-personal">
      <div class="section-head"><span class="section-head__ghost" aria-hidden="true">PERSON</span><p class="eyebrow">Beyond the clinic</p><h2>The person behind the practitioner</h2><p>Outside work, Ashton enjoys running, hiking, gym training, travelling and boardgames with friends. She is also a committed Melbourne Storm and North Melbourne supporter—and usually has a book, podcast or research paper on hypermobility close by.</p></div>
    </section>

    <section id="location" class="section staff-location">
      <div class="section-head staff-location__head"><span class="section-head__ghost" aria-hidden="true">NEWPORT</span><p class="eyebrow">Where to see Ashton</p><h2>Appointments in Newport and online</h2></div>
      <div class="staff-location__grid"><div class="location-card" style="background-image: url('/assets/images/locations/newport-storefront.jpg');"><span class="location-card__pin"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span><a href="/locations/newport/" class="location-card__link" aria-label="View Newport clinic"><i class="fas fa-external-link-alt" aria-hidden="true"></i></a><h3>Newport</h3><p class="location-card__address"><i class="fas fa-map-marker-alt" aria-hidden="true"></i>109 Blackshaws Rd, Newport</p><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book</a></div></div><article class="staff-online-card"><span><i class="fas fa-laptop-medical" aria-hidden="true"></i></span><div><h3>Online consultations</h3><p>For people who need specialised support outside Melbourne or prefer the accessibility of an online appointment.</p><a href={bookingUrl} class="btn btn--outline-navy">View online options <i class="fas fa-arrow-right" aria-hidden="true"></i></a></div></article></div>
    </section>

    <section class="section section--navy closing-cta"><div class="section-head closing-cta__head"><span class="section-head__ghost" aria-hidden="true">START</span><p class="eyebrow">Your next step</p><h2>Book an appointment with Ashton</h2><p class="closing-cta__copy">Choose a Newport or online appointment, or call the clinic if you would like help deciding whether Ashton is the right practitioner for you.</p></div><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book online <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a href={home.site.phoneHref} class="btn btn--outline">Call {home.site.phoneDisplay}</a></div></section>
  </main>

  <footer class="site-footer"><div class="site-footer__inner"><div class="site-footer__grid"><div><a href="/" class="site-footer__logo"><img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" /></a><p>Multidisciplinary sports medicine clinics across Melbourne. Care built around your goals.</p></div><div><h5>Clinics</h5><ul><li><a href="/locations/ascot-vale/">Ascot Vale</a></li><li><a href="/locations/newport/">Newport</a></li><li><a href="/locations/bacchus-marsh/">Bacchus Marsh</a></li><li><a href="https://maps.app.goo.gl/bBiEZyTG2B6cS8ry8">Hawthorn</a></li></ul></div><div><h5>About</h5><ul><li><a href="/about/">Our clinic</a></li><li><a href="/about/team/">Meet the team</a></li><li><a href="/about/qualifications/">Qualifications</a></li></ul></div><div><h5>Contact</h5><ul><li><a href={home.site.phoneHref}>{home.site.phoneDisplay}</a></li><li><a href="/contact/">Contact us</a></li><li><a href={bookingUrl}>Book online</a></li></ul></div></div><div class="site-footer__bottom"><p>&copy; 2026 Alpha Sports Medicine.</p></div></div></footer>
  <script is:inline src="/assets/js/main.js"></script>
</body>
</html>
