---
import { getCollection } from 'astro:content';
import home from '../data/home.json';

interface Props {
  context: 'service' | 'condition';
  slug: string;
  variant?: 'hero' | 'section';
}

const { context, slug, variant = 'section' } = Astro.props;
const practitioners = await getCollection('practitioners');
const matches = practitioners
  .filter(({ data }) => data.featureOnLinkedPages && data[context === 'service' ? 'services' : 'conditions'].includes(slug))
  .sort((a, b) => a.data.featurePriority - b.data.featurePriority);
const practitioner = matches[0]?.data;
const bookingUrl = practitioner?.bookingUrl && practitioner.bookingUrl !== '#book'
  ? practitioner.bookingUrl
  : home.site.bookingUrl.startsWith('#') ? `/${home.site.bookingUrl}` : home.site.bookingUrl;
const locationLabel = practitioner?.locations.map((location) => location.replaceAll('-', ' ')).join(' · ');
const isHero = variant === 'hero';
---

<section class:list={['practitioner-feature', `practitioner-feature--${variant}`, { section: !isHero, 'section--alt': !isHero }]} aria-label={practitioner ? `Meet ${practitioner.name}` : 'Meet the Alpha Sports Medicine team'}>
  <div class="practitioner-feature__inner">
    <div class="practitioner-feature__media">
      {practitioner?.videoUrl ? (
        <video controls preload="metadata" playsinline poster={practitioner.videoPoster || practitioner.portrait} aria-label={`Introduction from ${practitioner.name}`}>
          <source src={practitioner.videoUrl} />
          Your browser does not support embedded video.
        </video>
      ) : (
        <img src={practitioner?.portrait || '/assets/images/team/alpha-team-group.jpg'} alt={practitioner?.portraitAlt || 'Alpha Sports Medicine practitioners'} loading={isHero ? 'eager' : 'lazy'} fetchpriority={isHero ? 'high' : 'auto'} />
      )}
      {practitioner && isHero && (
        <>
          <span class="practitioner-feature__caption">
            <span class="practitioner-feature__caption-name">Meet {practitioner.name.replace(/^Dr\s+/, '')}</span>
            <span class="practitioner-feature__caption-title">{practitioner.role}</span>
          </span>
          {practitioner.videoUrl ? (
            <button type="button" class="practitioner-feature__play" data-practitioner-play aria-label={`Play introduction from ${practitioner.name}`}><i class="fas fa-play" aria-hidden="true"></i></button>
          ) : (
            <span class="practitioner-feature__play" aria-hidden="true"><i class="fas fa-play"></i></span>
          )}
        </>
      )}
      {practitioner && !isHero && <span class="practitioner-feature__media-label"><i class="fas fa-user-md" aria-hidden="true"></i> Your care team</span>}
    </div>
    {!isHero && <div class="practitioner-feature__copy">
      <p class="eyebrow eyebrow--left">{practitioner ? 'Meet a practitioner' : 'A connected team'}</p>
      <h2>{practitioner ? `Meet ${practitioner.shortName}` : 'The right practitioner for your goals'}</h2>
      {practitioner ? (
        <>
          <p class="practitioner-feature__role">{practitioner.role}</p>
          <p>{practitioner.intro}</p>
          {locationLabel && <p class="practitioner-feature__locations"><i class="fas fa-map-marker-alt" aria-hidden="true"></i> {locationLabel}</p>}
          <div class="btn-group">
            <a href={practitioner.profileUrl} class:list={['btn', isHero ? 'btn--outline' : 'btn--outline-navy']}>Meet {practitioner.shortName} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            <a href={bookingUrl} class="btn btn--primary">Book an appointment</a>
          </div>
        </>
      ) : (
        <>
          <p>We will match you with a practitioner whose service, clinical interests and location fit what you need.</p>
          <div class="btn-group">
            <a href="/about/" class:list={['btn', isHero ? 'btn--outline' : 'btn--outline-navy']}>Meet Alpha <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            <a href={bookingUrl} class="btn btn--primary">Book an appointment</a>
          </div>
        </>
      )}
    </div>}
  </div>
</section>

<style>
  .practitioner-feature__inner { max-width: var(--width-wide); margin: auto; display: grid; align-items: center; gap: var(--space-8); }
  .practitioner-feature__media { position: relative; min-width: 0; overflow: hidden; border-radius: var(--radius-xl); background: var(--color-navy); }
  .practitioner-feature__media img, .practitioner-feature__media video { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: center top; }
  .practitioner-feature__media-label { position: absolute; left: var(--space-4); bottom: var(--space-4); padding: var(--space-2) var(--space-3); display: inline-flex; align-items: center; gap: var(--space-2); color: #fff; background: rgba(23,43,55,.9); border-radius: var(--radius-md); font-weight: 700; }
  .practitioner-feature__media-label i { color: var(--color-primary); }
  .practitioner-feature__copy > p:not(.eyebrow) { color: var(--color-muted); line-height: 1.65; }
  .practitioner-feature__role { margin-bottom: var(--space-3); color: var(--color-navy) !important; font-family: var(--font-heading); font-weight: 700; }
  .practitioner-feature__locations { text-transform: capitalize; }
  .practitioner-feature__locations i { margin-right: var(--space-2); color: var(--color-primary); }
  .practitioner-feature__copy .btn-group { margin-top: var(--space-6); }
  .practitioner-feature--hero { padding: 0; color: #fff; }
  .practitioner-feature--hero .practitioner-feature__inner { display: block; }
  .practitioner-feature--hero .practitioner-feature__media { width: 100%; max-width: 420px; height: 460px; margin: 0 auto; overflow: visible; background: linear-gradient(160deg, rgba(242,95,45,.14), rgba(255,255,255,.05)); border: 1px solid rgba(255,255,255,.12); border-radius: 28px; }
  .practitioner-feature--hero .practitioner-feature__media img { position: absolute; right: 0; bottom: 0; width: auto; max-width: none; height: 112%; aspect-ratio: auto; object-fit: contain; filter: drop-shadow(0 24px 32px rgba(0,0,0,.35)); }
  .practitioner-feature--hero .practitioner-feature__media video { width: 100%; height: 100%; aspect-ratio: auto; object-fit: cover; object-position: center top; border-radius: 28px; }
  .practitioner-feature__caption { position: absolute; left: 20px; bottom: 24px; z-index: 2; display: flex; flex-direction: column; gap: 2px; max-width: calc(100% - 110px); }
  .practitioner-feature__caption-name { color: var(--color-primary); font-family: var(--font-heading); font-size: 1.4rem; font-weight: 700; letter-spacing: .01em; text-shadow: 0 2px 10px rgba(0,0,0,.55), 0 1px 2px rgba(0,0,0,.6); }
  .practitioner-feature__caption-title { color: #fff; font-size: .8rem; font-weight: 600; letter-spacing: .02em; text-shadow: 0 2px 8px rgba(0,0,0,.55), 0 1px 2px rgba(0,0,0,.6); }
  .practitioner-feature__play { position: absolute; right: 20px; bottom: 20px; z-index: 2; width: 64px; height: 64px; padding: 0; display: flex; align-items: center; justify-content: center; color: #fff; background: var(--color-primary); border: 3px solid rgba(255,255,255,.9); border-radius: 50%; box-shadow: 0 12px 28px rgba(242,95,45,.55), 0 0 0 6px rgba(242,95,45,.18); font-size: 1.15rem; }
  button.practitioner-feature__play { cursor: pointer; }
  .practitioner-feature__play[hidden] { display: none; }
  button.practitioner-feature__play:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
  @media (min-width: 768px) { .practitioner-feature--section .practitioner-feature__inner { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 1023px) { .practitioner-feature--hero .practitioner-feature__media { height: 400px; overflow: hidden; } .practitioner-feature--hero .practitioner-feature__media img { height: 100%; width: 100%; object-fit: cover; } }
</style>

<script is:inline>
  document.querySelectorAll('[data-practitioner-play]').forEach((button) => {
    const video = button.parentElement?.querySelector('video');
    if (!video) return;
    button.addEventListener('click', () => {
      video.play();
      button.hidden = true;
    });
    video.addEventListener('pause', () => { button.hidden = false; });
    video.addEventListener('ended', () => { button.hidden = false; });
  });
</script>
